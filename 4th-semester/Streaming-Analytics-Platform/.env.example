# ============================================
# STREAMING ANALYTICS PLATFORM - ENVIRONMENT VARIABLES
# ============================================
# 
# IMPORTANT: Copy this file to .env and fill in your actual values
# 
# To get started:
# 1. Copy this file: cp .env.example .env
# 2. Update values with your actual configuration
# 3. Do NOT commit .env to GitHub

# ============================================
# MONGODB CONNECTIONS
# ============================================

# MongoDB Connection URI
# Replace <username>, <password>, <cluster>, and <database> with your actual values
# Example: mongodb+srv://user:password@mydb.mongodb.net/mydb?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# For local development, you can use:
# MONGODB_URI=mongodb://localhost:27017/streaming_db

# PRODUCTION CONNECTIONS (COMMENTED FOR NOW)
# MONGODB_URI_ADMIN="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"
# MONGODB_URI_USER="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"
# MONGODB_URI_VIEWER="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"
# MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"

# ============================================
# APPLICATION SETTINGS
# ============================================

# Flask Secret Key
# Generate a strong random string for production
# You can use: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY="your-secret-key-here-change-this"

# Password Encryption Salt
# Use a strong random string in production
PASSWORD_SALT="your-password-salt-here"

# ============================================
# FEATURE FLAGS
# ============================================

# Enable/disable features
ENABLE_USER_REGISTRATION="true"
ENABLE_GUEST_ACCESS="true"
ENABLE_ADMIN_PANEL="true"

# ============================================
# SUBSCRIPTION PLANS
# ============================================

# Plan prices (USD)
PLAN_BASIC_PRICE="4.99"
PLAN_PREMIUM_PRICE="9.99"
PLAN_FAMILY_PRICE="14.99"

# ============================================
# DEBUG SETTINGS
# ============================================

# Flask Debug Mode
# Set to "false" in production
FLASK_DEBUG="true"

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# ============================================
# SETUP INSTRUCTIONS
# ============================================
#
# 1. CREATE MONGODB ATLAS ACCOUNT
#    - Go to https://www.mongodb.com/cloud/atlas
#    - Create free tier cluster
#    - Create database user
#    - Get connection string
#
# 2. UPDATE MONGODB_URI
#    - Replace <username> with your database user
#    - Replace <password> with your database password
#    - Replace <cluster> with your cluster name
#    - Replace <database> with your database name
#
# 3. GENERATE FLASK_SECRET_KEY
#    Run: python -c "import secrets; print(secrets.token_hex(32))"
#    Copy output to FLASK_SECRET_KEY
#
# 4. SET PASSWORD_SALT
#    Set to a random string, e.g.: "my_secure_salt_2024_random"
#
# 5. TEST CONNECTION
#    python app.py
#
